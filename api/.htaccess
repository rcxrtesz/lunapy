# API de LunaPy: solo index.php es accesible desde fuera.
Options -Indexes

<FilesMatch ".*">
    Require all denied
</FilesMatch>
<FilesMatch "^index\.php$">
    Require all granted
</FilesMatch>

# El asistente responde por partes: sin comprimir, para que cada trozo llegue en cuanto sale.
<IfModule mod_setenvif.c>
    SetEnvIfNoCase Request_URI "/asistente$" no-gzip=1
</IfModule>
